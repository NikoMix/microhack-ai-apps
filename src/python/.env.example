# ============================================================
# Zava AI Agent Platform — Python Track
# Environment variables template
# Copy to .env and fill in values for local development.
# NEVER commit .env to source control.
# ============================================================

# ── Inference provider ────────────────────────────────────
# Options: github | azure-openai | foundry  (default: github)
INFERENCE_PROVIDER=github
EMBEDDINGS_PROVIDER=github

# ── GitHub Models (default / free tier) ──────────────────
# Get a PAT with models:read at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_CHAT_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Azure OpenAI ──────────────────────────────────────────
# Auth: DefaultAzureCredential — no API key needed in code.
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Azure AI Foundry ──────────────────────────────────────
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<name>
AZURE_AI_FOUNDRY_CHAT_DEPLOYMENT=gpt-4o-mini

# ── Azure infrastructure (emitted by azd provision) ──────
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE=zava
POSTGRES_HOST=<server>.postgres.database.azure.com
POSTGRES_DB=zava
POSTGRES_PORT=5432
POSTGRES_USER=zava_app
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_INDEX=zava-knowledge
AZURE_DOCINTEL_ENDPOINT=https://<service>.cognitiveservices.azure.com
AZURE_CONTENTSAFETY_ENDPOINT=https://<service>.cognitiveservices.azure.com
AZURE_KEY_VAULT_ENDPOINT=https://<vault>.vault.azure.net
APPLICATIONINSIGHTS_CONNECTION_STRING=

# User-assigned Managed Identity client ID (for DefaultAzureCredential hints)
AZURE_CLIENT_ID=

# ── Data directory (for local / github mode) ─────────────
# Defaults to ../../data relative to src/python/ — set if running from elsewhere
# DATA_DIR=/absolute/path/to/data
